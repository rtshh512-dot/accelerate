+void packCudaPose(const Transform& T, double out[12]) {
+  for (int r = 0; r < 3; ++r) {
+    for (int c = 0; c < 3; ++c) out[4 * r + c] = T.linear()(r, c);
+    out[4 * r + 3] = T.translation()(r);
+  }
+}
+
+bool packCudaMap(const BIEVRMap& map, std::vector<uint64_t>& keys,
+                 std::vector<gpu_geo::VoxelPod>& pods, std::vector<float>& pool) {
+  std::vector<std::pair<uint64_t, const Voxel*>> entries;
+  entries.reserve(map.size());
+  map.forEachVoxel([&](const Voxel& voxel) {
+    if (voxel.num_points_ == 0) return;
+    const V3 centroid = voxel.sum_ / static_cast<double>(voxel.num_points_);
+    entries.emplace_back(static_cast<uint64_t>(map.hashIndex(centroid)), &voxel);
+  });
+  std::sort(entries.begin(), entries.end(),
+            [](const auto& a, const auto& b) { return a.first < b.first; });
+  if (entries.size() > static_cast<size_t>(std::numeric_limits<int>::max())) return false;
+  keys.reserve(entries.size());
+  pods.reserve(entries.size());
+  for (const auto& [key, voxel] : entries) {
+    if (voxel->bump_smoothed_.rows() != voxel->bump_weights_.rows() ||
+        voxel->bump_smoothed_.cols() != voxel->bump_weights_.cols()) return false;
+    const size_t pixels = static_cast<size_t>(voxel->bump_smoothed_.size());
+    if (pool.size() + 2 * pixels > static_cast<size_t>(std::numeric_limits<int>::max()))
+      return false;
+    keys.push_back(key);
+    pods.emplace_back();
+    auto& pod = pods.back();
+    const auto& R = voxel->T_C_W_.linear();
+    const auto& t = voxel->T_C_W_.translation();
+    for (int r = 0; r < 3; ++r) {
+      for (int c = 0; c < 3; ++c) pod.T_C_W[4 * r + c] = R(r, c);
+      pod.T_C_W[4 * r + 3] = t(r);
+    }
+    const V3 centroid = voxel->sum_ / static_cast<double>(voxel->num_points_);
+    for (int j = 0; j < 3; ++j) pod.centroid[j] = centroid(j);
+    pod.height = static_cast<int>(voxel->bump_smoothed_.rows());
+    pod.width = static_cast<int>(voxel->bump_smoothed_.cols());
+    pod.image_offset = static_cast<int>(pool.size());
+    for (int r = 0; r < pod.height; ++r)
+      for (int c = 0; c < pod.width; ++c) pool.push_back(voxel->bump_smoothed_(r, c));
+    pod.weight_offset = static_cast<int>(pool.size());
+    for (int r = 0; r < pod.height; ++r)
+      for (int c = 0; c < pod.width; ++c) pool.push_back(voxel->bump_weights_(r, c));
+    if (voxel->intensity_smoothed_.size() > 0) {
+      if (voxel->intensity_smoothed_.rows() != pod.height ||
+          voxel->intensity_smoothed_.cols() != pod.width ||
+          voxel->intensity_weights_.rows() != pod.height ||
+          voxel->intensity_weights_.cols() != pod.width ||
+          pool.size() + 2 * pixels > static_cast<size_t>(std::numeric_limits<int>::max()))
+        return false;
+      pod.intensity_offset = static_cast<int>(pool.size());
+      for (int r = 0; r < pod.height; ++r)
+        for (int c = 0; c < pod.width; ++c)
+          pool.push_back(voxel->intensity_smoothed_(r, c));
+      pod.intensity_weight_offset = static_cast<int>(pool.size());
+      for (int r = 0; r < pod.height; ++r)
+        for (int c = 0; c < pod.width; ++c)
+          pool.push_back(voxel->intensity_weights_(r, c));
+    }
+  }
+  return !keys.empty();
+}
