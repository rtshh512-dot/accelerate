+}
+
+void releaseMap() {
+  if (g_keys) cudaFree(g_keys);
+  if (g_voxels) cudaFree(g_voxels);
+  if (g_pool) cudaFree(g_pool);
+  if (g_pose) cudaFree(g_pose);
+  if (g_H) cudaFree(g_H);
+  if (g_H_geo) cudaFree(g_H_geo);
+  if (g_H_photo) cudaFree(g_H_photo);
+  if (g_b) cudaFree(g_b);
+  if (g_cost) cudaFree(g_cost);
+  if (g_count) cudaFree(g_count);
+  if (g_photo_count) cudaFree(g_photo_count);
+  g_keys = nullptr;
+  g_voxels = nullptr;
+  g_pool = nullptr;
+  g_pose = g_H = g_b = g_cost = nullptr;
+  g_H_geo = g_H_photo = nullptr;
+  g_count = nullptr;
+  g_photo_count = nullptr;
+  g_n_keys = 0;
+  g_pool_size = 0;
+  g_points_capacity = 0;
+  if (g_points) cudaFree(g_points);
+  if (g_intensities) cudaFree(g_intensities);
+  if (g_photo_weights) cudaFree(g_photo_weights);
+  g_points = nullptr;
+  g_intensities = g_photo_weights = nullptr;
