+}
+
+RegistrationResiduals LsqRegistration::collectResiduals(const Transform& T_W_L) const {
+  RegistrationResiduals result;
+  result.geometry.reserve(points_j_.size());
+  if (intensities_j_) result.photo.reserve(points_j_.size());
+
+  for (size_t i = 0; i < points_j_.size(); ++i) {
+    const Point p_W = T_W_L * points_j_[i];
+    size_t hash = 0;
+    const Voxel* voxel = findVoxel(p_W, hash);
+    if (!voxel) continue;
+
+    const Point p_o = voxel->T_C_W_ * p_W;
+    const double x = p_o.x() * map_.inv_px_size;
+    const double y = p_o.y() * map_.inv_px_size;
+    double map_height = 0.0;
+    if ((!config_.img_residual || getSubPixelValue(voxel, x, y, map_height)) &&
+        std::isfinite(p_o.z() - map_height)) {
+      result.geometry.push_back(p_o.z() - map_height);
+    }
+
+    if (!intensities_j_ || (*intensities_j_)[i] < 0.0 ||
+        voxel->intensity_weights_.size() == 0) {
+      continue;
+    }
+    double map_intensity = 0.0;
+    if (getSubPixelValue(voxel->intensity_smoothed_, voxel->intensity_weights_, x, y,
+                         map_intensity)) {
+      const double r = (*intensities_j_)[i] - map_intensity;
+      if (std::isfinite(r)) result.photo.push_back(r);
+    }
+  }
+  return result;
+}
+
+const Voxel* LsqRegistration::findVoxel(const V3& p_W, size_t& hash_idx) const {
+  hash_idx = map_.hashIndex(p_W);
+  const bool sorted = config_.sorted_lookup && map_.sortedIndexValid();
+  if (sorted) {
+    if (const Voxel* voxel = map_.getVoxelSorted(static_cast<uint64_t>(hash_idx))) return voxel;
+  } else if (const Voxel* voxel = map_.getVoxel(hash_idx)) {
+    return voxel;
+  }
+  // Miss: search the 27 neighbours, then reuse the same backend for the new key.
+  if (!map_.nearestVoxel(p_W, hash_idx)) return nullptr;
+  return sorted ? map_.getVoxelSorted(static_cast<uint64_t>(hash_idx)) : map_.getVoxel(hash_idx);
+}
 
