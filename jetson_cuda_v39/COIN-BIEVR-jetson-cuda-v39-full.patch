+
+void LsqRegistration::freezePhotoConfidence(const Transform& T_W_L) {
+  frozen_photo_confidence_.clear();
+  if (!config_.photo_confidence || !intensities_j_) return;
+  frozen_photo_confidence_.assign(points_j_.size(), 0.0);
+  for (size_t i = 0; i < points_j_.size(); ++i) {
+    if ((*intensities_j_)[i] < 0.0) continue;
+    const Point p_W = T_W_L * points_j_[i];
+    size_t hash = 0;
+    const Voxel* voxel = findVoxel(p_W, hash);
+    if (!voxel) continue;
+    if (voxel->intensity_weights_.size() == 0) continue;
+    frozen_photo_confidence_[i] =
+        photoConfidence(config_, *voxel, p_W, T_W_L.translation());
+  }
+}
+
+int LsqRegistration::setWeakPhotoWeights(const Transform& T_W_L,
+                                         const Eigen::Matrix3d& weak_projector) {
+  weak_photo_weights_.assign(points_j_.size(), 0.0);
+  mean_weak_photo_weight_ = 0.0;
+  if (!intensities_j_) return 0;
+  int selected = 0;
+  for (size_t i = 0; i < points_j_.size(); ++i) {
+    if ((*intensities_j_)[i] < 0.0) continue;
+    const Point p_W = T_W_L * points_j_[i];
+    size_t hash = 0;
+    const Voxel* voxel = findVoxel(p_W, hash);
+    if (!voxel) continue;
+    if (voxel->intensity_weights_.size() == 0) continue;
+    const Point p_o = voxel->T_C_W_ * p_W;
+    const double x = p_o.x() * map_.inv_px_size;
+    const double y = p_o.y() * map_.inv_px_size;
+    double value = 0.0, dx = 0.0, dy = 0.0;
+    if (!sampleValueAndGradient(voxel->intensity_smoothed_,
+                                voxel->intensity_weights_, x, y, value, dx, dy))
+      continue;
+    const Eigen::RowVector3d j_t =
+        -(Eigen::RowVector2d(dx, dy) *
+          (voxel->T_C_W_.linear() * T_W_L.linear()).topRows<2>()) *
+        map_.inv_px_size;
+    const double total = j_t.squaredNorm();
+    if (!std::isfinite(total) || total <= 1e-12) continue;
+    const double quality =
+        std::clamp((j_t * weak_projector).squaredNorm() / total, 0.0, 1.0);
+    if (!std::isfinite(quality) || quality < 0.25) continue;
+    // Exclude low-confidence points from the 30-point stage gate. Store only
+    // directional quality here; linearize() applies confidence exactly once.
+    const double confidence = frozen_photo_confidence_.empty()
+                                  ? photoConfidence(config_, *voxel, p_W,
+                                                    T_W_L.translation())
+                                  : frozen_photo_confidence_[i];
+    if (config_.photo_confidence && confidence < 0.25) {
+      continue;
+    }
+    weak_photo_weights_[i] = quality;
+    mean_weak_photo_weight_ += quality;
+    ++selected;
+  }
+  if (selected > 0) mean_weak_photo_weight_ /= selected;
+  return selected;
+}
