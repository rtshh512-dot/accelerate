diff --git a/BIEVR/include/bievr_lio/bievr_map.h b/BIEVR/include/bievr_lio/bievr_map.h
index 303e1d3..7543929 100644
--- a/BIEVR/include/bievr_lio/bievr_map.h
+++ b/BIEVR/include/bievr_lio/bievr_map.h
@@ -71,6 +71,23 @@ class BIEVRMap {
   const Voxel* getVoxel(const size_t hash_idx) const;
   bool nearestVoxel(const Point& point, size_t& result) const;
 
+  // Compact, key-sorted view of the observed voxels.
+  //
+  // The registration probes the map once per source point and per LM iteration. A
+  // hash probe costs a hash computation plus a scattered read into the voxel arena;
+  // a binary search over a contiguous 8-byte key array touches far fewer cache
+  // lines, and the same layout (parallel key / payload arrays sorted by the voxel
+  // key) is what a GPU port needs. `buildSortedIndex()` is O(V log V) and is meant
+  // to be called once per scan, between the map update of the previous scan and the
+  // registration of the current one.
+  //
+  // The stored pointers stay valid until the next mutating call; those bump
+  // `mutation_stamp_`, so a stale index reports `sortedIndexValid() == false` and
+  // the caller falls back to the hash lookup.
+  void buildSortedIndex() const;
+  bool sortedIndexValid() const { return sorted_stamp_ == mutation_stamp_; }
+  const Voxel* getVoxelSorted(const uint64_t key) const;
+
   // Calls func(const Voxel&) for every observed voxel.
   template <typename Func>
   void forEachVoxel(Func&& func) const {
@@ -130,6 +147,13 @@ class BIEVRMap {
   ankerl::unordered_dense::map<size_t, VoxelEntry> map_;
   std::list<size_t> voxels_cache_;
 
+  // Sorted lookup index, see buildSortedIndex(). `mutable` because building it does
+  // not change the map itself.
+  mutable std::vector<uint64_t> sorted_keys_;
+  mutable std::vector<const Voxel*> sorted_voxels_;
+  mutable uint64_t sorted_stamp_ = 0;
+  uint64_t mutation_stamp_ = 0;
+
   Eigen::MatrixXd corner_offsets_;
   std::vector<Point> neighbor_offsets_;
 };
