+
+bool linearizeJoint(const double* points, const double* intensities,
+                    const double* photo_weights, int n_points,
+                    const double* pose, double voxel_size, double inv_px,
+                    double delta, double photo_scale, bool jacobians,
+                    LinearizeResult& out) {
+  if (!g_keys || !points || !intensities || !photo_weights || !pose || n_points <= 0 ||
+      !ensureScratch(n_points)) return false;
+  cudaEvent_t e0, e1;
+  if (cudaEventCreate(&e0) != cudaSuccess) return false;
+  if (cudaEventCreate(&e1) != cudaSuccess) { cudaEventDestroy(e0); return false; }
+  cudaEventRecord(e0);
+  const bool prepared =
+      cudaMemcpy(g_points,points,sizeof(double)*3*n_points,cudaMemcpyHostToDevice)==cudaSuccess &&
+      cudaMemcpy(g_intensities,intensities,sizeof(double)*n_points,cudaMemcpyHostToDevice)==cudaSuccess &&
+      cudaMemcpy(g_photo_weights,photo_weights,sizeof(double)*n_points,cudaMemcpyHostToDevice)==cudaSuccess &&
+      cudaMemcpy(g_pose,pose,sizeof(double)*12,cudaMemcpyHostToDevice)==cudaSuccess &&
+      cudaMemset(g_H,0,sizeof(double)*21)==cudaSuccess &&
+      cudaMemset(g_H_geo,0,sizeof(double)*21)==cudaSuccess &&
+      cudaMemset(g_H_photo,0,sizeof(double)*21)==cudaSuccess &&
+      cudaMemset(g_b,0,sizeof(double)*6)==cudaSuccess &&
+      cudaMemset(g_cost,0,sizeof(double))==cudaSuccess &&
+      cudaMemset(g_count,0,sizeof(int))==cudaSuccess &&
+      cudaMemset(g_photo_count,0,sizeof(int))==cudaSuccess;
+  if (!prepared) { cudaEventDestroy(e0); cudaEventDestroy(e1); return false; }
+  cudaEventRecord(e1); cudaEventSynchronize(e1);
+  float transfer=0.f; cudaEventElapsedTime(&transfer,e0,e1);
+  const int threads=256;
+  const int blocks=std::min(kMaxBlocks,(n_points+threads-1)/threads);
+  cudaEventRecord(e0);
+  jointKernel<<<blocks,threads>>>(g_points,g_intensities,g_photo_weights,n_points,
+      g_pose,voxel_size,inv_px,delta,photo_scale,g_keys,g_n_keys,g_voxels,g_pool,
+      jacobians?1:0,g_H,g_b,g_H_geo,g_H_photo,g_cost,g_count,g_photo_count);
+  cudaEventRecord(e1); cudaEventSynchronize(e1);
+  if (cudaGetLastError()!=cudaSuccess) {
+    cudaEventDestroy(e0); cudaEventDestroy(e1); return false;
+  }
+  float kernel=0.f; cudaEventElapsedTime(&kernel,e0,e1);
+  cudaEventRecord(e0);
+  const bool downloaded=
+      cudaMemcpy(out.H,g_H,sizeof(double)*21,cudaMemcpyDeviceToHost)==cudaSuccess &&
+      cudaMemcpy(out.H_geo,g_H_geo,sizeof(double)*21,cudaMemcpyDeviceToHost)==cudaSuccess &&
+      cudaMemcpy(out.H_photo,g_H_photo,sizeof(double)*21,cudaMemcpyDeviceToHost)==cudaSuccess &&
+      cudaMemcpy(out.b,g_b,sizeof(double)*6,cudaMemcpyDeviceToHost)==cudaSuccess &&
+      cudaMemcpy(&out.cost,g_cost,sizeof(double),cudaMemcpyDeviceToHost)==cudaSuccess &&
+      cudaMemcpy(&out.count,g_count,sizeof(int),cudaMemcpyDeviceToHost)==cudaSuccess &&
+      cudaMemcpy(&out.photo_count,g_photo_count,sizeof(int),cudaMemcpyDeviceToHost)==cudaSuccess;
+  if (!downloaded) { cudaEventDestroy(e0); cudaEventDestroy(e1); return false; }
+  cudaEventRecord(e1); cudaEventSynchronize(e1);
+  float download=0.f; cudaEventElapsedTime(&download,e0,e1);
+  g_kernel_ms=kernel; g_transfer_ms=transfer+download;
+  cudaEventDestroy(e0); cudaEventDestroy(e1);
+  return true;
+}
+
+bool linearize(const double* points, int n_points, const double* T_W_L, double voxel_size,
+               double inv_px_size, double huber_delta, bool compute_jacobians,
+               LinearizeResult& out) {
+  if (!g_keys || g_n_keys <= 0) return false;
+  if (!points || !T_W_L || n_points <= 0) return false;
+  if (!ensureScratch(n_points)) return false;
+
+  cudaEvent_t e0, e1;
+  if (cudaEventCreate(&e0) != cudaSuccess) return false;
+  if (cudaEventCreate(&e1) != cudaSuccess) { cudaEventDestroy(e0); return false; }
+
+  cudaEventRecord(e0);
+  const bool prepared =
+      cudaMemcpy(g_points, points, sizeof(double) * 3 * n_points, cudaMemcpyHostToDevice) == cudaSuccess &&
+      cudaMemcpy(g_pose, T_W_L, sizeof(double) * 12, cudaMemcpyHostToDevice) == cudaSuccess &&
+      cudaMemset(g_H, 0, sizeof(double) * 21) == cudaSuccess &&
+      cudaMemset(g_b, 0, sizeof(double) * 6) == cudaSuccess &&
+      cudaMemset(g_cost, 0, sizeof(double)) == cudaSuccess &&
+      cudaMemset(g_count, 0, sizeof(int)) == cudaSuccess;
+  if (!prepared) { cudaEventDestroy(e0); cudaEventDestroy(e1); return false; }
+  cudaEventRecord(e1);
+  cudaEventSynchronize(e1);
+  float transfer = 0.f;
+  cudaEventElapsedTime(&transfer, e0, e1);
+
+  const int threads = 256;
+  const int blocks = std::min(kMaxBlocks, (n_points + threads - 1) / threads);
+  cudaEventRecord(e0);
+  linearizeKernel<<<blocks, threads>>>(g_points, n_points, g_pose, voxel_size, inv_px_size,
+                                       huber_delta, g_keys, g_n_keys, g_voxels, g_pool,
+                                       compute_jacobians ? 1 : 0, g_H, g_b, g_cost, g_count);
+  cudaEventRecord(e1);
+  cudaEventSynchronize(e1);
+  if (cudaGetLastError() != cudaSuccess) {
+    cudaEventDestroy(e0);
+    cudaEventDestroy(e1);
+    return false;
+  }
+  float kernel = 0.f;
+  cudaEventElapsedTime(&kernel, e0, e1);
+
+  cudaEventRecord(e0);
+  const bool downloaded =
+      cudaMemcpy(out.H, g_H, sizeof(double) * 21, cudaMemcpyDeviceToHost) == cudaSuccess &&
+      cudaMemcpy(out.b, g_b, sizeof(double) * 6, cudaMemcpyDeviceToHost) == cudaSuccess &&
+      cudaMemcpy(&out.cost, g_cost, sizeof(double), cudaMemcpyDeviceToHost) == cudaSuccess &&
+      cudaMemcpy(&out.count, g_count, sizeof(int), cudaMemcpyDeviceToHost) == cudaSuccess;
+  if (!downloaded) { cudaEventDestroy(e0); cudaEventDestroy(e1); return false; }
+  cudaEventRecord(e1);
+  cudaEventSynchronize(e1);
+  float download_ms = 0.f;
+  cudaEventElapsedTime(&download_ms, e0, e1);
+
+  g_kernel_ms = kernel;
+  g_transfer_ms = transfer + download_ms;
+  cudaEventDestroy(e0);
+  cudaEventDestroy(e1);
+  return true;
+}
+
+double lastKernelMs() { return g_kernel_ms; }
+double lastTransferMs() { return g_transfer_ms; }
+
+}  // namespace gpu_geo
diff --git a/BIEVR/src/gpu_linearize.h b/BIEVR/src/gpu_linearize.h
new file mode 100644
index 0000000..466a389
--- /dev/null
+++ b/BIEVR/src/gpu_linearize.h
@@ -0,0 +1,68 @@
+// GPU prototype for the first-stage (geometry-only) registration.
+//
+// One thread per source point computes the voxel correspondence, the height-map
+// residual, the 1x6 geometric Jacobian and the Huber weight; a block reduction
+// produces the 6x6 H_g (21 upper-triangular entries), the 6x1 b_g and the cost.
+// The 6x6 LM solve stays on the CPU.
+#ifndef GPU_LINEARIZE_H_
+#define GPU_LINEARIZE_H_
+
+#include <cstdint>
+
+namespace gpu_geo {
+
+// Flat, transferable copy of one voxel. Mirrors the fields the CPU linearize()
+// reads: the plane-to-world transform, the smoothed height image and its mask.
+struct VoxelPod {
+  double T_C_W[12];  // 3x4 row-major R|t of the image frame
+  double centroid[3];
+  int width;
+  int height;
+  int image_offset;  // into the float pool (height values, row-major)
+  int weight_offset; // into the float pool (mask, same layout)
+  int intensity_offset = -1;
+  int intensity_weight_offset = -1;
+};
+
+// Result of one linearization pass.
+struct LinearizeResult {
+  double cost = 0.0;
+  int count = 0;      // points that produced a residual
+  double H[21] = {};  // upper triangle, row-major: (0,0)(0,1)...(5,5)
+  double b[6] = {};
+  int photo_count = 0;
+  double H_geo[21] = {};
+  double H_photo[21] = {};
+  double confidence_sum = 0.0;
+  int confidence_count = 0;
+};
+
+// Upload the map once per frame. Keys must be sorted; keys[s] belongs to voxels[s].
+bool uploadMap(const uint64_t* keys, const VoxelPod* voxels, int n_voxels,
+               const float* pool, int pool_size);
+
+void releaseMap();
+
+// One geometry linearization at the given pose.
+//   compute_jacobians=true  -> H, b and cost
+//   compute_jacobians=false -> cost only (LM trial evaluation)
+// Returns false when the map has not been uploaded.
+bool linearize(const double* points, int n_points, const double* T_W_L,
+               double voxel_size, double inv_px_size, double huber_delta,
+               bool compute_jacobians, LinearizeResult& out);
+
+// Joint geometry + intensity residual pass. Per-point quality/confidence is
+// frozen by the CPU before LM; intensity < 0 or weight <= 0 omits photo.
+bool linearizeJoint(const double* points, const double* intensities,
+                    const double* photo_weights, int n_points,
+                    const double* T_W_L, double voxel_size,
+                    double inv_px_size, double huber_delta, double photo_scale,
+                    bool compute_jacobians, LinearizeResult& out);
+
+// Device-side timings of the last call, milliseconds.
+double lastKernelMs();
+double lastTransferMs();
+
+}  // namespace gpu_geo
+
+#endif  // GPU_LINEARIZE_H_
